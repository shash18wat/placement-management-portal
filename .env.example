# Optional. If left blank, the app uses built-in local checks for feedback.
# Keep the real key in a local .env file or deployment secret manager. Never put it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LOG_LEVEL=INFO
# Leave disabled unless the public service is intentionally accepting fictional test uploads.
PUBLIC_DEMO_RESUME_UPLOADS=false
